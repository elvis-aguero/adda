@article{abaqusagent2026,
  title  = {AbaqusAgent: a multi-agent framework for end-to-end finite element analysis},
  author = {{LIRAM-LIN authors}},
  year   = {2026},
  note   = {arXiv:2606.00138. READ IN FULL. Nearest neighbour. Does not ingest
            documentation: curates 104 worked cases in one FAISS store,
            retrieval unit is a whole case. Ablation (n=20, Opus-4.6): RAG on
            90\% success / 634,690 tokens vs RAG off 80\% / 2,203,778 --- the
            large effect is efficiency, not accuracy. Same table on GPT-5.2
            gives 65\%/45\%: model choice moved the result more than the
            ablated feature. 40 of 50 eval cases are drawn from the retrieval
            library. [VERIFY] author list and exact title against the source.},
}

@article{pdeagents2026,
  title  = {PDE-Agents: LLM-orchestrated multi-agent finite element modelling
            with knowledge-graph reasoning},
  author = {{PDE-Agents authors}},
  year   = {2026},
  note   = {arXiv:2606.07850. READ IN FULL. Also routes around documentation:
            the graph holds material properties and run lineage, not manuals.
            Headline we lean on: ``integration pattern, rather than knowledge
            content, [decides] whether GraphRAG augmentation helps or hinders''.
            [VERIFY] author list and exact title against the source.},
}

@article{grepallyouneed2026,
  title  = {Is Grep All You Need? How agent harnesses reshape agentic search},
  author = {{Authors of arXiv:2605.15184}},
  year   = {2026},
  note   = {arXiv:2605.15184. READ IN FULL. Grep beat vector retrieval in their
            Experiment 1, but their own conclusion is that the harness, not the
            retrieval strategy, dominates. Benchmark is LongMemEval, where
            answers are licensed by distinctive strings --- the best case for
            lexical matching and a poor analogy for technical documentation.
            [VERIFY] author list against the source.},
}

